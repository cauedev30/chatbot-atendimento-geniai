# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/geniai_dev
# Empty, dedicated database for pytest: the tests truncate it.
TEST_DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/geniai_test
PORT=8000
HOST=0.0.0.0
# Secret path segment of the webhook URL: /webhooks/chatwoot/<WEBHOOK_TOKEN>
WEBHOOK_TOKEN=change-me-to-a-long-random-string
CHATWOOT_BASE_URL=https://chatwoot.example.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=
# Any OpenAI-compatible chat completions endpoint.
LLM_BASE_URL=https://llm.example.com/v1
LLM_API_KEY=
LLM_MODEL=
# Optional provider-specific JSON merged into each request body (e.g. to turn reasoning off).
LLM_EXTRA_BODY_JSON=
BOARD_USER=suporte
# At least 16 characters.
BOARD_PASSWORD=
# At least 32 characters.
COOKIE_SECRET=
SECURE_COOKIE=true
# Serve /docs, /redoc and /openapi.json (off by default).
ENABLE_API_DOCS=false
# Frontend addresses or networks whose X-Forwarded-For is believed (login attempt limit). In separate
# containers, the frontend container's address.
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Test mode: comma-separated phones the bot serves; every other conversation goes to the team at once.
# Empty = the bot serves everyone. Group conversations always go to the team.
BOT_ONLY_PHONES=
# true: customer images are downloaded from Chatwoot (at most 5 MB, JPEG, PNG or WebP) and sent to the LLM
# provider with the turn; the model must accept images. false (default): the bot says it cannot open them.
LLM_READS_IMAGES=false
# Customer audios (up to 2 min) are downloaded from Chatwoot and transcribed by any OpenAI-compatible
# /audio/transcriptions endpoint, set apart from the LLM's. Set all three to turn it on; empty (default):
# the bot says it cannot hear audio. The transcription is sent to the LLM as the customer's text and posted
# as a private note in the Chatwoot conversation.
TRANSCRIBE_BASE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=
# Optional overrides of geniai/domain/rules.py
BURST_WINDOW_MS=
SILENCE_TIMEOUT_HOURS=
# python -m geniai.eval.run: JSON list of candidates, e.g.
# [{"label":"candidate-a","baseUrl":"https://llm.example.com/v1","model":"model-a","apiKeyEnv":"CANDIDATE_A_KEY"}]
# Add "readsImages":true to a candidate that accepts images: it also runs the 4 image cases.
EVAL_CANDIDATES=
