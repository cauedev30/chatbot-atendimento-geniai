# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/geniai_dev
# Empty, dedicated database for pytest: the tests truncate it.
TEST_DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/geniai_test
PORT=8000
HOST=0.0.0.0
# Secret path segment of the webhook URL: /webhooks/chatwoot/<WEBHOOK_TOKEN>
WEBHOOK_TOKEN=change-me-to-a-long-random-string
CHATWOOT_BASE_URL=https://chatwoot.example.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=
# Any OpenAI-compatible chat completions endpoint.
LLM_BASE_URL=https://llm.example.com/v1
LLM_API_KEY=
LLM_MODEL=
# Optional provider-specific JSON merged into each request body (e.g. to turn reasoning off).
LLM_EXTRA_BODY_JSON=
BOARD_USER=suporte
BOARD_PASSWORD=
# At least 32 characters.
COOKIE_SECRET=
SECURE_COOKIE=true
# Serve /docs, /redoc and /openapi.json (off by default).
ENABLE_API_DOCS=false
# Frontend addresses or networks whose X-Forwarded-For is believed (login attempt limit).
TRUSTED_PROXY_IPS=127.0.0.1,::1
# Optional overrides of geniai/domain/rules.py
BURST_WINDOW_MS=
SILENCE_TIMEOUT_HOURS=
# python -m geniai.eval.run: JSON list of candidates, e.g.
# [{"label":"candidate-a","baseUrl":"https://llm.example.com/v1","model":"model-a","apiKeyEnv":"CANDIDATE_A_KEY"}]
EVAL_CANDIDATES=
