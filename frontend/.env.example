# Copy to .env.local and fill in. Never commit .env.local.
# The FastAPI backend. Server Components call it directly; next.config.ts proxies /api/* to it, so the
# browser sees one origin and the backend's session cookie just works. Read at build and at start.
BACKEND_URL=http://127.0.0.1:8000
# true only when a reverse proxy in front of this app sets X-Forwarded-For (see the README, "Login
# attempts"); otherwise the X-Forwarded-For and X-Real-IP a client sends to /api are dropped.
TRUST_UPSTREAM_PROXY=false
